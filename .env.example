# PostgreSQL. En Neon usa la cadena *pooled* con sslmode=require:
# postgresql://usuario:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/rrhh

# Autenticación (cambia el secreto en producción)
BETTER_AUTH_SECRET=cambia-esto-por-una-cadena-larga-aleatoria
BETTER_AUTH_URL=http://localhost:3000
# Orígenes extra permitidos por better-auth (separados por coma)
BETTER_AUTH_TRUSTED_ORIGINS=
# Exigir email verificado para poder iniciar sesión
AUTH_REQUIRE_EMAIL_VERIFICATION=false
# Enviar email de verificación al registrarse
AUTH_SEND_VERIFICATION_ON_SIGNUP=false

# Email (SMTP corporativo). Si se deja vacío, los emails se registran en consola.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="RRHH Suite <rrhh@miempresa.com>"
